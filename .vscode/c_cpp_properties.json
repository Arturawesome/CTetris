{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/brick_game/tetris/src",
                "${workspaceFolder}/gui/cli/src",
                "/opt/homebrew/include",
                "/opt/homebrew/opt/check/include"
            ],
            "defines": [
                "_POSIX_C_SOURCE=200809L"
            ],
            "macFrameworkPath": [
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "macos-gcc-arm64"
        }
    ],
    "version": 4
}